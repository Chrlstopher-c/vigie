# Adresses du serveur ccremote, injectées dans l'Info.plist au build.
# Copier en `.env.local` (non suivi) et renseigner les vraies valeurs.
# Le dépôt ne doit jamais porter d'adresse réelle : voir `Info.template.plist`.

# Tunnel public (Cloudflare, posé par `deploy-web-pi.sh` côté Pi).
VIGIE_TUNNEL=https://vigie.example.com

# Repli LAN, quand le tunnel est coupé mais que le WiFi de la maison est là.
VIGIE_LAN=http://vigie.local:8766
